---
const navItems = [
  { label: 'خانه', href: '/' },
  { label: 'معرفی مجتمع', href: '/#intro' },
  { label: 'امکانات مجتمع', href: '/#feature' },
  { label: 'نقشه طبقات', href: '/#maps' },
  { label: 'رویداد‌ها', href: '/blog/' },
  { label: 'تماس با ما', href: '/#contact' },
];

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
---

<header class="fixed top-0 left-0 right-0 w-full z-50 transition-all duration-200">
  <div
    id="nav-div"
    data-is-home={isHome ? 'true' : 'false'}
    class={`w-full transition-all duration-200 px-4 lg:px-12 py-2 flex items-center justify-between ${
      isHome ? 'bg-transparent' : 'bg-[#353535] shadow-[0_1px_10px_#353535]'
    }`}
  >
    <!-- Logo & Nav Wrap (RTL Right side) -->
    <div class="flex items-center gap-6 lg:gap-12">
      <a href="/" class="block shrink-0">
        <img
          id="logo"
          src="/assets/logo/logo-red.png"
          alt="مهروماه"
          width="100"
          height="52"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-10 sm:h-12 w-auto py-1"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:block">
        <ul class="flex items-center m-0 p-0 list-none">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-center px-5 h-[60px] text-[17px] font-medium text-white hover:bg-[#f00] hover:text-white transition-colors text-center"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Mobile Hamburger Toggle (Left side in RTL) -->
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden p-2 text-white hover:text-red-500 transition-colors"
      aria-label="منوی اصلی"
    >
      <svg class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#353535] border-t border-zinc-700 shadow-2xl">
    <nav class="flex flex-col">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-6 py-4 text-base font-medium text-zinc-100 hover:bg-[#f00] hover:text-white transition-colors border-b border-zinc-700/50"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const navDiv = document.getElementById('nav-div');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const isHome = navDiv?.getAttribute('data-is-home') === 'true';

    function handleScroll() {
      if (!navDiv) return;
      if (window.scrollY > 50) {
        navDiv.classList.add('bg-[#353535]', 'shadow-[0_1px_10px_#353535]');
        navDiv.classList.remove('bg-transparent');
      } else if (isHome) {
        navDiv.classList.remove('bg-[#353535]', 'shadow-[0_1px_10px_#353535]');
        navDiv.classList.add('bg-transparent');
      }
    }

    if (isHome) {
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    menuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
