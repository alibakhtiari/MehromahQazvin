---
const currentShamsiYear = new Date().toLocaleDateString('fa-IR', { year: 'numeric' });
---

<div class="copyright-area copyright-area__" data-aos="fade-up" data-aos-offset="0">
  <svg class="blurp--bottom" width="192" height="61" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 160.7 61.5" enable-background="new 0 0 160.7 61.5" xml:space="preserve">
    <path fill="#262626" d="M80.3,61.5c0,0,22.1-2.7,43.1-5.4s41-5.4,36.6-5.4c-21.7,0-34.1-12.7-44.9-25.4S95.3,0,80.3,0c-15,0-24.1,12.7-34.9,25.4S22.3,50.8,0.6,50.8c-4.3,0-6.5,0,3.5,1.3S36.2,56.1,80.3,61.5z"/>
  </svg>
  <div class="btn--top">
    <a href="#home" id="scroll-to-top" class="btn--top_text" aria-label="backtotop">
      <span class="btn__arrow btn__arrow--top"></span>
      <span class="btn__arrow btn__arrow--bottom"></span>
    </a>
  </div>
</div>
<footer>
  <div class="container mx-auto px-4 py-6">
    <div class="row">
      <div class="full-width copyrights text-center space-y-2">
        <p>© ۱۳۹۷ - {currentShamsiYear} تمامی حقوق مادی و معنوی وب سایت متعلق به مجتمع تجاری مهروماه می باشد .</p>
        <div class="white flex items-center justify-center gap-1.5 text-sm text-zinc-300">
          <span>کد نویسی با</span>
          <div class="code flex-shrink-0"></div>
          <span>توسط</span>
          <!-- Crisp Symmetrical Pulsing Red Heart -->
          <svg class="w-4 h-4 fill-red-500 animate-pulse inline-block align-middle mx-0.5 flex-shrink-0" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <a
            href="http://webabc.ir"
            target="_blank"
            rel="noopener"
            title="طراحی سایت و سئو - تیم وب آ ب ث"
            class="text-red-500 font-bold hover:underline"
          >
            تیم طراحی سایت وب آ ب ث
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
.copyright-area,
footer {
    position: relative;
    font-size: 14px;
    text-align: center;
    background-color: #262626;
}

.copyright-area {
    height: 30px;
}

.copyright-area svg {
    position: absolute;
    top: 0;
    right: 50%;
    margin-right: -96px;
    margin-top: -50px;
}

.copyright-area svg path {
    fill: #262626;
}

.btn--top {
    position: absolute;
    top: -12px;
    right: 50%;
    transform: translateX(50%);
}

.btn--top_text {
    display: block;
    position: absolute;
    top: 12px;
    right: 50%;
    width: 60px;
    height: 60px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
    color: #fff;
    transform: translateX(50%) translateY(-30%);
}

.btn--top_text .btn__arrow {
    display: block;
    position: absolute;
    right: 50%;
    height: 10px;
    width: 10px;
    border-right: 2px solid #fff;
    border-top: 2px solid #fff;
    transform: translateX(50%) rotate(-45deg);
}

.btn--top_text .btn__arrow--top {
    top: 2px;
}

.btn--top_text .btn__arrow--bottom {
    top: 8px;
}

.code {
    display: inline-block;
    height: 0.75rem;
    margin: 0 0.25rem;
    position: relative;
    width: 0.75rem;
    border: 0.125rem solid #4169e1;
    transform: translateY(0.0625rem) scale(1.33) rotate(45deg);
}

.code::before,
.code::after {
    content: "";
    display: block;
    position: absolute;
    height: 0.375rem;
    width: 0.375rem;
    background-color: #262626;
}

.code::before {
    top: -0.16rem;
    left: -0.16rem;
}

.code::after {
    right: -0.16rem;
    bottom: -0.16rem;
}
</style>

<script>
  const btn = document.getElementById('scroll-to-top');
  if (btn) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>
