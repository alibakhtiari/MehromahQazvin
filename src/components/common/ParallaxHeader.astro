---
export interface Props {
  title: string;
  subtitle?: string;
  bgImage?: string;
}

const { title, subtitle, bgImage = '/assets/images/hero.jpg' } = Astro.props;
---

<div
  class="relative py-24 text-center text-white parallax-bg border-b border-zinc-800"
  style={`background-image: url('${bgImage}');`}
>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 space-y-3 max-w-4xl mx-auto px-4">
    <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">{title}</h2>
    {subtitle && <h3 class="text-xl sm:text-2xl font-bold text-red-600">{subtitle}</h3>}
  </div>
</div>
