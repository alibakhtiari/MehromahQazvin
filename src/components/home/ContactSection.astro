---
---

<!-- Parallax Banner 3 -->
<div
  class="relative py-24 text-center text-white parallax-bg border-y border-zinc-800"
  style="background-image: url('/assets/images/3.jpg');"
>
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative z-10 space-y-3" data-aos="fade-down">
    <h2 class="text-3xl sm:text-4xl font-bold text-white">تماس با ما</h2>
    <h3 class="text-xl sm:text-2xl font-bold text-red-500">هرگونه سوالی که دارید با ما در میان بگذارید.</h3>
  </div>
</div>

<!-- Contact Section -->
<section id="contact" class="py-16 sm:py-24 bg-[#222222] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      
      <!-- Contact Widgets (Right Column in RTL) -->
      <div class="md:col-span-6 space-y-6 text-right" data-aos="fade-left">
        <!-- Title: RED -->
        <h2 class="text-3xl font-bold text-red-500 mb-8">تماس با ما</h2>

        <!-- Address: Icon far right, vertical line, then text -->
        <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-4">
          <div class="text-zinc-400 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" class="w-6 h-6 fill-zinc-300">
              <path d="M312 128c0-13.26-10.75-24-24-24s-24 10.74-24 24c0 13.25 10.75 24 24 24s24-10.74 24-24zm248.02 32c-1.96 0-3.98.37-5.96 1.16L384.01 224H384l-10.27-3.62c23.3-34.86 42.28-71.2 42.28-97.33C416 55.09 358.69 0 288 0S160 55.09 160 123.05c0 11.8 4.02 25.75 10.39 40.64L20.12 215.96C7.97 220.81 0 232.58 0 245.67v250.32C0 505.17 7.53 512 15.99 512c1.96 0 3.97-.37 5.96-1.16L192 448l172 60.71a63.98 63.98 0 0 0 40.05.15l151.83-52.81A31.996 31.996 0 0 0 576 426.34V176.02c0-9.19-7.53-16.02-15.98-16.02zM176 419.8L31.91 473.05l-1.28-226.87L176 195.61V419.8zM288 32c52.94 0 96 40.84 96 91.05 0 27-38.09 88.89-96 156.77-57.9-67.88-96-129.77-96-156.77C192 72.84 235.06 32 288 32zm80 444.19l-160-56.48V228.82c24.42 35.27 52.14 68 67.71 85.66 3.24 3.68 7.77 5.52 12.29 5.52s9.05-1.84 12.29-5.52c12.76-14.47 33.7-39.11 54.28-66.94l13.42 4.74v223.91zm32 .2V252.21l144.09-53.26 1.28 226.87L400 476.39z" />
            </svg>
          </div>
          <span class="text-zinc-600 font-light text-lg">|</span>
          <p class="text-zinc-200 text-base font-medium">آدرس : خیابان خیام مجتمع تجاری مهر و ماه</p>
        </div>

        <!-- Phone: Icon far right, vertical line, then text -->
        <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-4">
          <div class="text-zinc-400 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="w-6 h-6 fill-zinc-300">
              <path d="M487.8 24.1L387 .8c-14.7-3.4-29.8 4.2-35.8 18.1l-46.5 108.5c-5.5 12.7-1.8 27.7 8.9 36.5l53.9 44.1c-34 69.2-90.3 125.6-159.6 159.6l-44.1-53.9c-8.8-10.7-23.8-14.4-36.5-8.9L18.9 351.3C5 357.3-2.6 372.3.8 387L24 487.7C27.3 502 39.9 512 54.5 512 306.7 512 512 307.8 512 54.5c0-14.6-10-27.2-24.2-30.4zM55.1 480l-23-99.6 107.4-46 59.5 72.8c103.6-48.6 159.7-104.9 208.1-208.1l-72.8-59.5 46-107.4 99.6 23C479.7 289.7 289.6 479.7 55.1 480z" />
            </svg>
          </div>
          <span class="text-zinc-600 font-light text-lg">|</span>
          <p class="text-zinc-200 text-base font-medium">تلفن تماس : ۰۲۸۳۳۳۵۶۲۰۶</p>
        </div>

        <!-- Email: Icon far right, vertical line, then text -->
        <div class="flex items-center gap-3 border-b border-zinc-800/80 pb-4">
          <div class="text-zinc-400 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="w-6 h-6 fill-zinc-300">
              <path d="M464 64H48C21.5 64 0 85.5 0 112v288c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zM48 96h416c8.8 0 16 7.2 16 16v41.4c-21.9 18.5-53.2 44-150.6 121.3-16.9 13.4-50.2 45.7-73.4 45.3-23.2.4-56.6-31.9-73.4-45.3C85.2 197.4 53.9 171.9 32 153.4V112c0-8.8 7.2-16 16-16zm416 320H48c-8.8 0-16-7.2-16-16V195c22.8 18.7 58.8 47.6 130.7 104.7 20.5 16.4 56.7 52.5 93.3 52.3 36.4.3 72.3-35.5 93.3-52.3 71.9-57.1 107.9-86 130.7-104.7v205c0 8.8-7.2 16-16 16z" />
            </svg>
          </div>
          <span class="text-zinc-600 font-light text-lg">|</span>
          <p class="text-zinc-200 text-base font-medium">پست الکترونیکی : info@mehromahqazvin.ir</p>
        </div>

        <!-- Working Hours -->
        <div class="pt-2 border-b border-zinc-800/80 pb-4">
          <p class="text-zinc-200 text-base font-normal">
            <strong class="font-bold">ساعت کار پارکینگ :</strong> ۶ صبح الی ۱۲ شب
          </p>
        </div>

        <!-- Social Icons Section: Instagram first (far right), then WhatsApp (left) -->
        <div class="pt-4 space-y-3">
          <p class="text-zinc-400 text-sm">ما را در شبکه های اجتماعی دنبال کنید.</p>

          <div class="flex items-center gap-3">
            <!-- Instagram Icon (1st child in RTL -> renders on far right) -->
            <a
              href="https://www.instagram.com/mehromahqazvin/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg bg-zinc-800/90 border border-zinc-700/60 flex items-center justify-center hover:bg-red-600 hover:border-red-600 transition-colors group"
              aria-label="اینستاگرام"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="w-5 h-5 fill-zinc-300 group-hover:fill-white transition-colors">
                <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z" />
              </svg>
            </a>

            <!-- WhatsApp Icon (2nd child in RTL -> renders to the left of Instagram) -->
            <a
              href="https://wa.me/989120000000"
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg bg-zinc-800/90 border border-zinc-700/60 flex items-center justify-center hover:bg-red-600 hover:border-red-600 transition-colors group"
              aria-label="واتساپ"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="w-5 h-5 fill-zinc-300 group-hover:fill-white transition-colors">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Google Maps Frame (Left Column in RTL) -->
      <div class="md:col-span-6 w-full h-[400px] rounded-xl overflow-hidden shadow-2xl border border-zinc-700" data-aos="fade-right">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3216.5694630634835!2d50.008003599999995!3d36.2742302!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ff35539dd09600b%3A0x1ccb55051e910c30!2sMehr%20O%20Mah%20Shopping%20Center!5e0!3m2!1sen!2sfi!4v1760264428706!5m2!1sen!2sfi"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="گوگل مپ مهروماه"
        ></iframe>
      </div>

    </div>
  </div>
</section>
