---
import BaseLayout from './BaseLayout.astro';
import BlogSidebar from '@/components/blog/BlogSidebar.astro';

export interface Props {
  title: string;
  pubDate?: string;
  category?: string;
  image?: string;
  author?: string;
  description?: string;
}

const { title, pubDate, image, author = 'مدیریت مهروماه', description } = Astro.props;

function formatShamsiDate(dateStr?: string) {
  if (!dateStr) return '';
  try {
    const d = new Date(dateStr);
    return new Intl.DateTimeFormat('fa-IR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }).format(d);
  } catch (e) {
    return dateStr;
  }
}

const shamsiDate = formatShamsiDate(pubDate);
---

<BaseLayout title={title} description={description} image={image} type="article" pubDate={pubDate} author={author}>
  <div class="bg-[#eef0f2] min-h-screen pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Main Article Container (Right Column in RTL) -->
        <div class="md:col-span-9">
          <article class="bg-white p-8 sm:p-12 rounded-lg shadow-sm border border-zinc-200 text-right space-y-6">
            
            <!-- Meta Details -->
            <div class="flex items-center gap-4 text-xs text-red-600 font-medium pb-4 border-b border-zinc-100">
              <span>نویسنده: {author}</span>
              {pubDate && (
                <>
                  <span>•</span>
                  <time datetime={pubDate}>{shamsiDate}</time>
                </>
              )}
            </div>

            <!-- Title -->
            <h1 class="text-2xl sm:text-4xl font-black text-zinc-900 leading-tight">
              {title}
            </h1>

            <!-- Featured Image -->
            {image && (
              <div class="overflow-hidden rounded-lg my-6">
                <img
                  src={image}
                  alt={title}
                  loading="eager"
                  decoding="async"
                  class="w-full h-auto object-cover max-h-[550px] rounded-lg mx-auto"
                />
              </div>
            )}

            <!-- Post Content -->
            <div class="prose prose-lg max-w-none text-zinc-800 leading-relaxed font-normal prose-headings:font-bold prose-headings:text-zinc-900 prose-a:text-red-600 prose-img:rounded-lg">
              <slot />
            </div>

            <!-- Back Link -->
            <div class="pt-8 border-t border-zinc-100 flex justify-between items-center text-sm">
              <a
                href="/blog/"
                class="inline-flex items-center gap-2 font-semibold text-red-600 hover:text-zinc-900 transition-colors"
              >
                <span>&rarr;</span> بازگشت به لیست اخبار
              </a>
            </div>

          </article>
        </div>

        <!-- Sidebar Column (Left Column in RTL) -->
        <div class="md:col-span-3">
          <BlogSidebar />
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
