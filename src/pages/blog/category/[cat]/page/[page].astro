---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map(p => p.data.category || 'ev'))];

  return categories.flatMap((cat) => {
    const filteredPosts = posts.filter(p => (p.data.category || 'ev') === cat);
    return [
      {
        params: { cat, page: '2' },
        props: { cat, pageNum: 2, posts: filteredPosts },
      }
    ];
  });
}

const { cat, pageNum, posts } = Astro.props;
---

<BaseLayout title={`دسته‌بندی ${cat} - صفحه ${pageNum}`} description={`آرشیو مطالب دسته‌بندی ${cat} - صفحه ${pageNum}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center space-y-4">
      <h1 class="text-3xl font-bold text-white">دسته‌بندی: {cat} (صفحه {pageNum})</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        const postUrl = `/blog/${post.data.year || '2017'}/${post.data.month || '07'}/${post.data.id || '1173'}/`;
        return (
          <article class="bg-slate-800/40 p-6 rounded-2xl border border-slate-700/60 space-y-3">
            <h2 class="text-xl font-bold text-white">
              <a href={postUrl} class="hover:text-brand-400">{post.data.title}</a>
            </h2>
            <p class="text-sm text-slate-400">{post.data.description}</p>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
