---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
---

<BaseLayout title="رویدادها و همایش‌ها | مجتمع مهروماه قزوین" description="تقویم رویدادها، جشم‌ها و همایش‌های مجتمع تجاری اداری مهروماه قزوین">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center space-y-4">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20">
        برنامه‌ها و جشن‌ها
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">رویدادهای مهروماه</h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">گزارش تصویری و تقویم همایش‌ها، مسابقات و جشن‌های مناسبتی</p>
    </div>

    {events.length === 0 ? (
      <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-12 text-center space-y-4 max-w-2xl mx-auto">
        <div class="text-4xl">🎉</div>
        <h2 class="text-xl font-bold text-white">رویدادهای جدید به زودی اعلان خواهند شد</h2>
        <p class="text-sm text-slate-400">جهت اطلاع از برنامه جشن‌ها و قرعه‌کشی‌های ماهانه صفحه اخبار را دنبال کنید.</p>
        <a href="/blog/" class="inline-block px-6 py-2.5 rounded-xl bg-brand-600 text-white font-medium text-sm">
          مشاهده اخبار و مطالب
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {events.map((event) => (
          <div class="bg-slate-800/40 p-8 rounded-2xl border border-slate-700/60 space-y-4">
            <h2 class="text-2xl font-bold text-white">{event.data.title}</h2>
            <p class="text-sm text-slate-400">{event.data.description}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
