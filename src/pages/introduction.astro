---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/home/ContactSection.astro';
---

<BaseLayout
  title="معرفی مدیریت - مجتمع تجاری مهروماه قزوین"
  description="شرکت عمران و سازندگی استان قزوین با همکاری شرکت توسعه انبوه سازی پاسارگاد به جهت ایجاد ایرانی آباد به ساخت مجتمع تجاری مهروماه قزوین همت گماردند."
>
  <!-- Parallax Header -->
  <div
    class="relative py-28 text-center text-white parallax-bg border-b border-zinc-800"
    style="background-image: url('/assets/images/hero.jpg');"
  >
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 space-y-3 max-w-4xl mx-auto px-4">
      <h2 class="text-3xl sm:text-5xl font-bold text-white">معرفی مجتمع</h2>
      <h3 class="text-xl sm:text-2xl font-bold text-red-500">معرفی مجتمع تجاری مهروماه</h3>
    </div>
  </div>

  <!-- Article Section -->
  <section class="py-16 bg-white text-zinc-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 text-justify">
      
      <h3 class="text-xl sm:text-2xl font-bold text-center text-zinc-900 leading-relaxed">
        مجتمع تجاری مهروماه برترین ساختمان در بخش معماری جشنواره ساختمانهای برتر استان قزوین شناخته شد
      </h3>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        جشنواره ساختمانهای برتر استان قزوین روز چهارشنبه ۲۶ مهرماه با معرفی و شناخت آثار برتردر دو بخش ساختمانهای ۲ تا ۷ طبقه و یا کمتر از ۳۰ واحد و مجتمع های بیش از ۷ طبقه و بالای ۳۰ واحد در دانشگاه بین المللی امام خمینی برگزار گردید. نما،حجم و جلوه های بصری ،معماری داخلی ،کیفیت ساخت و رعایت مقررات ساختمانی به همراه صرفه جویی در مصرف انرژی و سازگاری با محیط زیست از جمله محورهای این جشنواره بودند.برای انتخاب و معرفی برترین ساختمانهای موجود استان ۵ داور از چهره ها و اساتید برجسته و مطرح ملی انتخاب شده و در هر محور نیز از آثار برتر تقدیر به عمل آمد. با افتخار اعلام میداریم در بخش ساختمانهای بیش از ۷ طبقه یا مجتمع های بالای ۳۰ واحد در بخش معماری که شامل ارزشهای معمارانه و هویتی می باشد،جناب آقای مهندس رئوفیان مدیر عامل شرکت عمران و سازندگی برای ارائه مجتمع تجاری مهروماه مورد تجلیل قرار گرفتند.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/100.jpg" alt="افتخارات مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/101.jpg" alt="افتخارات مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        مجتمع تجاری مهر و ماه که یکی از بزرگترین مراکز خرید شهر قزوین محسوب میشود که در زمینی به مساحت ۳۲۲۵ مترمربع در مرکز شهر در تقاطع خیابانهای خیام و بوعلی با زیربنایی بالغ بر ۴۰۰۰۰ مترمربع در ۱۲ طبقه احداث شده است.<br />
        پنج طبقه آن شامل واحدهای تجاری موتورخانه مرکزی، انباریها، سرویسهای بهداشتی و نمازخانه و ۷ طبقه آن پارکینگ عمومی با گنجایش ۱۰۰۰ اتومبیل میباشد. در طراحی مجتمع مهروماه تلفیقی از معماری سنتی و مدرن بکار گرفته شده است که نظر بینندگان زیادی را به خود جلب میکند.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/110.jpg" alt="نمای مجتمع" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/111.jpg" alt="نمای مجتمع" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        مجتمع تجاری مهروماه اگر چه در مرکز تجاری و شلوغ شهر قراردارد ولی با داشتن ۱۰۰۰ واحد پارکینگ عمومی در سطح فوقانی خود، یکی از دغدغه های شهروندان که همانا نبود پارکینگ در مرکز شهر می باشد را برای همیشه حل نموده و با اینکار آسایش و آرامش خاطر آنها را در طول خرید و استراحت از فودکورت را فراهم نموده است.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/120.jpg" alt="پارکینگ مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/121.jpg" alt="پارکینگ مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        از شاخصه های دیگر مجتمع مهروماه شیب راه بودن آن است به این معنا که طبقات تجاری در یک شیب ملایم احداث شده بطوریکه وقتی شما مسیر رفت و برگشت راهروئی را بطرف بالا یا پائین بطور کامل طی میکنید بی آنکه متوجه شده باشید و بدون آنکه از آسانسور یا پله برقی یا معمولی استفاده کرده باشید به میزان یک طبقه به ارتفاع ۶ متر تغییر مکان پیدا نموده اید.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/130.jpg" alt="شیب راهه مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/131.jpg" alt="شیب راهه مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        پس از خرید و دیدن طبقات تجاری و خستگی های ناشی از آنها معمولاً شهروندان دنبال رستوران یا کافی شاپی هستند که ضمنناول غذا و یا نوشیدنیهای گرم و سرد استراحت کرده باشند.<br />
        مجتمع مهروماه با احداث فودکورت مهروماه دریک محیطی زیبا و دلنشین با چشم‌اندازی به شهر قزوین این امکان را برای مراجعین خود فراهم نموده است.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/144.jpg" alt="فودکورت مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/142.jpg" alt="فودکورت مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/141.jpg" alt="فودکورت مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/145.jpg" alt="فودکورت مهروماه" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        مجتمع مهروماه در کنار کار خرید و تجارت از امور فرهنگی غافل نمانده با اختصاص مکانهایی به نام کافه هنرمندان سعی نموده است پاتوقی از هنرمندان شهر را برای ارائه خدمات مختلف هنری به شهروندان دایر نماید.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/150.jpg" alt="کافه هنرمندان" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/151.jpg" alt="کافه هنرمندان" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        به هنگام انتخاب و خرید یکی از مشکلات خانواده ها حضور بچه های شیرخوار و کودکان بوده و هست، چرا که معمولاً پدرومادرها دوست دارند به هنگام خرید ضمن اینکه بچه ها مزاحم آنها نباشند ولی در عین حال بچه ها در کنار پدرو مادر باشند. مجتمع تجاری مهروماه این مشکل را برای اولین بار در قزوین،با اختصاص مکانی تحت عنوان نگهداری کودکان زیر نظر مربیان و معلمان مجربو تجهیزات و وسایل بازی متنساب با سنین بچه ها حل نمایند زمانیکه پدرومادرها مشغول گشت و انتخاب و خرید هستند فرزندان دلبند آنها مشغول بازیهای متناسب با سنشان هستند که این امر برای پدرومادرها بسیار دلپذیر و آرامش بخش خواهد بود.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/160.jpg" alt="اتاق کودک" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/161.jpg" alt="اتاق کودک" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-zinc-700">
        شرکت عمران و سازندگی استان قزوین (سهامی عام) متولی و سازنده مجتمع تجاری و پارکینگ طبقاتی مهروماه با رعایت صداقت و امانت و اصول ایمنی و استاندارد کار، تلاش نموده با استفاده از بهترین و با کیفیت ترین مصالح از ابتدا تا انتهای کار محیطی ایمن و استاندارد و در عین حال زیبا ارائه نماید.<br />
        بطور مثال در ساخت اسکلت مجتمع تمامی اصول و آئین نامه های ملی ساختمان در ارتباط با زلزله را رعایت کند و یا با بکارگیری با کیفیت ترین و مدرنترین تجهیزات مجتمع را به سیستم هوشمند اعلام و اطفای حریق مجهز کند.<br />
        موتورخانه مرکزی مجهز به تجهیزات مدرن و استاندارد گرمایش و سرمایش و هوای مطبوع طبقات را تدمین میکند بطوریکه کسانیکه در طبقات زیرین مجتمع کار میکنند با کسانیکه در طبقات فوقانی هستند بطور یکسان از هوای گرم و مطبوع در زمستان و هوای خنک و مطبوع در تابستان برخوردار میباشند.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6">
        <img src="/assets/images/intro/170.jpg" alt="موتورخانه مرکزی" class="w-full h-auto rounded-lg shadow-lg object-cover" />
        <img src="/assets/images/intro/171.jpg" alt="موتورخانه مرکزی" class="w-full h-auto rounded-lg shadow-lg object-cover" />
      </div>

    </div>
  </section>

  <ContactSection />
</BaseLayout>
